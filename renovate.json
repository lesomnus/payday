{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "github>lesomnus/payday//renovate/base"
  ],
  "timezone": "Asia/Seoul",
  "schedule": [
    "* 0-8 * * 1"
  ],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Apps follow our direct and indirect requirements through payday upgrades, so keep indirect Go modules current here too. The generators left to reviewed upgrades by the base preset remain excluded.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "matchPackageNames": ["!github.com/lesomnus/payday", "!github.com/lesomnus/payday/**", "!github.com/protobuf-orm/**"],
      "enabled": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^internal/pdcli/template/ts/package\\.json\\.tmpl$/"
      ],
      "matchStrings": [
        "\"(?<depName>@?[a-z0-9][a-z0-9._/-]*)\": \"(?<currentValue>[~^][0-9][^\"]*)\""
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "The npm that stages a release, which `.github/workflows/npm.yaml` names by its version rather than `latest`.",
      "managerFilePatterns": [
        "/^\\.github/workflows/npm\\.yaml$/"
      ],
      "matchStrings": [
        "npm install -g npm@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "npm",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ],
  "vulnerabilityAlerts": {
    "schedule": [
      "at any time"
    ],
    "labels": [
      "security"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "reviewers": [
    "lesomnus"
  ]
}
