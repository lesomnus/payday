{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "github>lesomnus/payday//renovate/base"
  ],
  "timezone": "Asia/Seoul",
  "schedule": [
    "* 0-8 * * 1"
  ],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Apps follow our direct and indirect requirements through payday upgrades, so keep indirect Go modules current here too. The generators left to reviewed upgrades by the base preset remain excluded.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "matchPackageNames": ["!github.com/lesomnus/payday", "!github.com/lesomnus/payday/**", "!github.com/protobuf-orm/**"],
      "enabled": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^internal/pdcli/template/ts/package\\.json\\.tmpl$/"
      ],
      "matchStrings": [
        "\"(?<depName>@?[a-z0-9][a-z0-9._/-]*)\": \"(?<currentValue>[~^][0-9][^\"]*)\""
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "The toolchain `pd new` writes, which is payday's own: the gomod manager moves the one in go.mod, this moves the template's with it, and a test holds the two to one another. The same dependency the gomod manager makes of a toolchain line.",
      "managerFilePatterns": [
        "/^internal/pdcli/template/go\\.mod\\.tmpl$/"
      ],
      "matchStrings": [
        "\\ntoolchain go(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\n"
      ],
      "depNameTemplate": "go",
      "depTypeTemplate": "toolchain",
      "datasourceTemplate": "golang-version"
    },
    {
      "customType": "regex",
      "description": "The npm that stages a release, which `.github/workflows/npm.yaml` names by its version rather than `latest`.",
      "managerFilePatterns": [
        "/^\\.github/workflows/npm\\.yaml$/"
      ],
      "matchStrings": [
        "npm install -g npm@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "npm",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ],
  "vulnerabilityAlerts": {
    "schedule": [
      "at any time"
    ],
    "labels": [
      "security"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "reviewers": [
    "lesomnus"
  ]
}
