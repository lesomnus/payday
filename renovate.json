{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Asia/Seoul",
  "schedule": [
    "* 0-8 * * 1"
  ],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ],
      "groupName": "non-major"
    },
    {
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-react"
      ],
      "groupName": "vite"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^internal/pdcli/template/ts/package\\.json\\.tmpl$/"
      ],
      "matchStrings": [
        "\"(?<depName>@?[a-z0-9][a-z0-9._/-]*)\": \"(?<currentValue>[~^][0-9][^\"]*)\""
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ],
  "vulnerabilityAlerts": {
    "schedule": [
      "at any time"
    ],
    "labels": [
      "security"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "reviewers": [
    "lesomnus"
  ]
}
