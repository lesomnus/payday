{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noImplicitOverride": true,
		"exactOptionalPropertyTypes": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"declaration": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"src",
		"gen"
	],
	// The panel is a browser and is checked by `tsconfig.dom.json`, which is
	// the only place `DOM` is in `lib`.
	"exclude": [
		"src/react/devtools.tsx",
		"src/react/form.tsx",
		"src/react/json.tsx"
	]
}
