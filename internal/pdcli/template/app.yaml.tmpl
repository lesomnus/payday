# What this deployment is configured with.
#
# A file, then the environment over the top of it: `{{.Env}}_DB_DSN` beats what
# is written here. `{{.Name}} config` prints what came out, and
# `{{.Name}} config env` lists every variable there is.

db:
  driver: sqlite3
  dsn: "file:{{.Name}}.db?_pragma=foreign_keys(1)"

server:
  addr: ":50051"

  # The second listener, for whatever cannot speak gRPC -- which is every
  # browser. Delete this block and no port is opened, which is what an app with
  # no page in front of it should do.
  #
  # It is the same server: a call arrives as JSON over POST, is re-encoded and
  # handed to the handler a gRPC client would have reached, so it goes through
  # the same interceptors and behind the same wall.
  http:
    addr: ":8080"
    allow_web: true
    # Which page may call. Nothing here is same-origin only, which is right for
    # a built UI this server also serves and wrong for `npm run dev` -- that is
    # 5173, and a different origin.
    origins: ["http://localhost:5173"]

watch:
  # Named rather than defaulted, and it is the one field this app is refused for
  # leaving out. `memory` publishes inside this process, which is right for one
  # replica and silently wrong for two -- a client watching against one never
  # hears about a write that landed on another, and nothing reports it.
  broker: memory

# How long the trail keeps a row. Every write this app makes is recorded, and
# **nothing else applies a window**: with no block here the table is kept whole,
# forever, and it is the one that grows without anybody writing to it.
#
# Left out rather than filled in, because a scaffold cannot know what this app
# is regulated as -- and a wrong number here is the mistake worth being loudest
# about, since it works: the sweep runs, the table stops growing, every graph
# improves, and what it is doing is destroying the evidence.
#
# `retain` is how long a row stays in the database and `destroy` is how long the
# archive holds it afterwards. Naming `retain` with nowhere for the rows to go
# is refused where this process comes up, unless `discard: true` says the
# deployment means to keep nothing.
#
# `profile:` fills both from a named regime -- pci, hipaa, sox, pipa,
# pipa-sensitive, gdpr, forever -- and `trail.Profiles` carries the sentence
# each number comes from, so what is written here is arguable rather than
# arbitrary. Anything set beside a profile wins.
#
# `by:` is per kind of thing, keyed by what the schema registered. Obligations
# are not uniform: what was done to a person eventually has to stop existing,
# and what a machine did is an operating record with the opposite requirement.
#
# audit:
#   profile: pipa
#   archive: /var/lib/{{.Name}}/audit
#   by:
#     holder:
#       profile: gdpr
